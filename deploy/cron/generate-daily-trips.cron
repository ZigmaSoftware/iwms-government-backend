# Daily Trip Job Scheduler — runs inside the backend container.
# Replaces the old host-level scheduler.sh + host crontab.
#
# Every day at 00:05, generates DailyTripAssignments for every
# ACTIVE + APPROVED + auto-assign TripPlan whose repeat_days includes
# today's weekday. Idempotent — safe to run more than once.
#
# Output goes to stdout so it shows up in `docker compose logs backend`.
#
# Manual run (inside the container):
#   docker compose exec backend python manage.py generate_daily_trips
# Specific day:
#   docker compose exec backend python manage.py generate_daily_trips --date 2026-06-26

5 0 * * * . /etc/container_environment.sh; cd /app && python manage.py generate_daily_trips >> /proc/1/fd/1 2>> /proc/1/fd/2
